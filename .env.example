# ─────────────────────────────────────────────────────────────────────────────
# Core — required for the app to run.
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=

# Where the app's own +api.ts routes are reachable FROM THE DEVICE.
#
# Optional locally, and normally left blank here: in dev,
# src/services/api/stream.ts derives the Metro host automatically.
#
# For BUILDS this is not set from this file at all — it comes from the EAS
# environment variables (`eas env:create ... --environment production`), which
# the preview/production build profiles consume. See DEPLOYMENT.md.
#
# Set it here only to point a local dev client at the deployed EAS Hosting
# backend instead of your local Metro server.
EXPO_PUBLIC_API_BASE_URL=
# Same value as STREAM_API_KEY — the API key is not secret, only STREAM_API_SECRET is.
EXPO_PUBLIC_STREAM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AI Teacher — OPTIONAL. Everything below this line can be left blank.
#
# Lessons are pre-built content graded on the device, so the learner flow works
# with none of these set and no vision-agent service running. They are needed
# only if EXPO_PUBLIC_ENABLE_AI_TEACHER is "true".
# ─────────────────────────────────────────────────────────────────────────────

# Set to "true" to show the AI Teacher tab and its audio-lesson feature.
# Anything else (including blank) keeps it off, which is the default.
EXPO_PUBLIC_ENABLE_AI_TEACHER=

GEMINI_API_KEY=

# Base URL of the running vision-agent/ service (Gemini Live Ajami teacher).
# session+api.ts calls its POST /calls/:callId/sessions to have it join the
# lesson call. Not secret — just where that service is reachable.
VISION_AGENT_URL=http://localhost:8000

# Shared secret proving session+api.ts (and only session+api.ts) is allowed to
# call the vision-agent's HTTP endpoints. Same value as vision-agent/.env's
# VISION_AGENT_SECRET — do not rename.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VISION_AGENT_SECRET=
