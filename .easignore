# .easignore — what NOT to upload to EAS Build.
#
# IMPORTANT: when this file exists, EAS uses it INSTEAD of .gitignore, not in
# addition to it. Anything that should stay out of the build archive has to be
# listed here even if .gitignore already covers it — otherwise it starts being
# uploaded the moment this file is added.
#
# Written after a build failed to upload: the archive had reached 158 MB and
# the connection reset partway through.

# ── Dependencies ─────────────────────────────────────────────────────────────
# Reinstalled on the build server from package-lock.json.
node_modules/

# ── The vision-agent service ─────────────────────────────────────────────────
# A separate Python service with its own Dockerfile, deployed independently.
# The Android build never compiles or runs it, and its .venv alone is ~380 MB.
vision-agent/

# ── Build output and caches ──────────────────────────────────────────────────
.metro-cache/
.metro-health-check*
.expo/
dist/
web-build/
*.tsbuildinfo

# ── Authoring and reference material, not part of the app ────────────────────
prompt_material/
prompts/
.agents/
.github/

# ── Native project folders — regenerated by prebuild on the build server ─────
/ios
/android
.kotlin/

# ── Local secrets ────────────────────────────────────────────────────────────
.env
.env*.local

# ── Signing material — EAS uses the remote keystore, never a local one ───────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ── Editor and OS noise ──────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*
*.orig.*
