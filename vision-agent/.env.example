# Same value as the parent repo's .env — see AGENTS.md / repo root .env.
GEMINI_API_KEY=

# Same value as the parent repo's .env (STREAM_API_KEY / STREAM_API_SECRET —
# do not rename, this is what src/app/api/stream/session+api.ts uses too).
STREAM_API_KEY=
STREAM_API_SECRET=

# Base URL of the running Expo app (dev server or deployed EAS Hosting URL).
# Used to fetch lesson content from /api/lessons/:lessonId at join time.
LESSON_API_BASE_URL=http://localhost:8081
